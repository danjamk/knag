{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",

  // Pinned, not floated. A moving compatibility date changes runtime behaviour
  // under a deploy that touched nothing else.
  "compatibility_date": "2026-07-01",

  // ───────────────────────────────────────────────────────────────────────────
  // Two Cloudflare accounts. See docs/adr/ADR-002-two-accounts-and-migrations.md.
  //
  // 🔴 Which account you reach is decided by WHICH CREDENTIAL IS ACTIVE, not by
  // anything in this file:
  //
  //   dev   CLOUDFLARE_API_TOKEN in .env.local  → every local `make deploy`
  //   dev   a GitHub Environment secret          → only deploy-dev.yml, on merge
  //   prod  a GitHub Environment secret          → only deploy-prod.yml, manual
  //
  // Three locations, two accounts. Each is readable only by the job that names it —
  // an Environment secret, never a repo-level one (ADR-002 §1b).
  //
  // The prod token is never on the laptop. That placement IS the guarantee — the
  // env blocks below only name resources, they grant nothing. A laptop holding the
  // dev token that runs `--env prod` fails closed, because the dev token cannot see
  // prod's D1.
  //
  // The TOP LEVEL IS DEV, deliberately: every command that forgets a flag does the
  // safe thing. `wrangler dev`, `wrangler deploy` and the test suite all read this
  // level. Production requires saying `--env prod` out loud.
  //
  // Named environments do NOT inherit bindings — d1_databases, vars, assets and
  // routes are redeclared under `env.prod` below. That is verbose and it is the
  // reason a binding added here must be added there too. Adding one in only one
  // place is the failure this comment exists to prevent.
  // ───────────────────────────────────────────────────────────────────────────

  "name": "knag-dev",

  // The document store. D1 holds the ONLY copy of the live document — there is no
  // second source of truth. `make backup` and D1 Time Travel (30 days) are the
  // recovery paths; treat both as load-bearing.
  //
  // Created on the DEV account 2026-08-15 with `wrangler d1 create knag-dev`. The id
  // is not a secret — it names a resource that only a credentialed request can reach,
  // which is why this file is committed and the token is not.
  //
  // The binding stays `DB`. Wrangler's create output suggests naming it after the
  // database (`knag_dev`); taking that suggestion would make the binding differ
  // between dev and prod, and every `env.DB` in the tree would have to know which
  // environment it was running in.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knag-dev",
      "database_id": "ac5d4b49-4556-43bd-abd1-151b01027c4f",
      "migrations_dir": "migrations"
    }
  ],

  // Token storage for the OAuth 2.1 provider (ADR-005). Grants, authorization codes
  // and access tokens — never the document, which stays in D1.
  //
  // The BINDING is `OAUTH_KV` because the library requires that exact name. The
  // NAMESPACE is titled `knag-dev-oauth`, per-project and per-environment, for the
  // same reason the D1 binding is `DB` while the database is `knag-dev`.
  //
  // 🔴 Do not create one titled `OAUTH_KV`. The dev Cloudflare account is shared with
  // other projects and already carries a stray namespace by that generic name; a
  // second project taking the default title is how two services end up issuing tokens
  // out of one store.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "40850ad736e5401c90901ae22e980bd7"
    }
  ],

  // The PWA shell — real files, not template literals inside a TS module.
  // `run_worker_first` keeps the API and MCP routes on the Worker; everything else
  // is served straight from assets, which costs no Worker invocation.
  //
  // 🔴 `/.well-known/*` is here to be REFUSED, not served. `not_found_handling:
  // "single-page-application"` answers every unmatched path with index.html and a
  // 200, so without this entry a client probing for OAuth metadata gets the PWA
  // shell and reads it as "this server's metadata is corrupt" rather than "this
  // server has no OAuth". The Worker 404s these paths honestly instead (index.ts).
  // Any discovery path knag later chooses to *answer* is already routed by this
  // wildcard — see docs/adr/ADR-005-mcp-oauth.md §4.
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/health", "/manifest.json", "/.well-known/*", "/oauth/*", "/login/*"],
    "not_found_handling": "single-page-application"
  },

  "vars": {
    // <semver>+<shortsha>, baked at deploy from package.json + git; reported by
    // /health so `make health` can assert that what is live matches the checkout
    // you are standing in.
    "KNAG_VERSION": "",
    "KNAG_DEPLOYED_AT": "",

    // dev or prod, baked at deploy. Blank here and in tests, which report "local".
    // 🔴 Also declared under env.prod below — named environments do not inherit
    // vars, and one declared in only one place reports the wrong environment in the
    // other. That is the exact failure this variable exists to catch.
    "KNAG_ENV": "",

    // Local timezone for history boundaries. D1 stores UTC; "what did I finish
    // Tuesday" is a local-time question and files to the wrong day after ~7pm
    // local if answered in UTC. See spec §14.3.
    "KNAG_TZ": "America/Chicago",

    // The login mail's sender (#231). Also under env.prod, where it is an address on the
    // zone Resend has verified. Dev uses Resend's own test sender, which delivers only to
    // the Resend account's address — exactly the operator, and nobody else — and does not
    // spend the real domain's reputation on a *.workers.dev host. `[dev]` is in the
    // subject either way.
    "KNAG_MAIL_FROM": "knag <onboarding@resend.dev>"
  },

  // 🔴 Dev is reachable at a *.workers.dev hostname with no WAF rate-limit rule in
  // front of it — the rule is scoped to the danjamkuhn.com zone, which lives on the
  // prod account. Consequences, both mandatory:
  //   1. Dev's KNAG_BEARER_TOKEN must be DIFFERENT from prod's, and dev's login mails
  //      say [dev] in the subject so a link from one cannot be mistaken for the other.
  //   2. Dev holds test content only. Never paste anything real into it.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  "env": {
    "prod": {
      // Not `knag-dev-prod`. Wrangler appends the environment name to the top-level
      // name unless the block sets its own.
      "name": "knag",

      // Created on the PROD account 2026-08-18, in the dashboard rather than with
      // `wrangler d1 create knag`: this machine holds no prod credential, so the CLI
      // cannot reach that account from here at all. That is the guarantee working, not
      // a limitation. The id is not a secret for the same reason the dev one above is
      // not — it names a resource only a credentialed request can reach.
      //
      // 🔴 The prod ACCOUNT id is a different thing and is NOT in this file. It lives
      // on the `production` GitHub Environment as the CLOUDFLARE_ACCOUNT_ID variable.
      // This repo is public and .gitignore stopped enumerating .env variants (#95)
      // because that id got into a commit once already.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "knag",
          "database_id": "96241dce-0aa0-48e1-9248-9cf7d2aa0a2c",
          "migrations_dir": "migrations"
        }
      ],

      // Created on the PROD account 2026-08-18, titled `knag-oauth` — per-project and
      // per-environment. Never the generic `OAUTH_KV`: that is the BINDING name the
      // library requires, and a namespace wearing it is how a second project on the
      // same account ends up issuing tokens out of this store.
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "ada2cee066c94278b35df0ea957cf666"
        }
      ],

      // 🔴 Must match the dev block's list exactly. A path routed in only one
      // environment works locally and serves the PWA shell in production.
      "assets": {
        "directory": "../public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/mcp", "/health", "/manifest.json", "/.well-known/*", "/oauth/*", "/login/*"],
        "not_found_handling": "single-page-application"
      },

      "vars": {
        "KNAG_VERSION": "",
        "KNAG_DEPLOYED_AT": "",
        "KNAG_ENV": "",
        "KNAG_TZ": "America/Chicago",
        "KNAG_MAIL_FROM": "knag <knag@danjamkuhn.com>"
      },

      // Prod's only hostname. `custom_domain: true` means WRANGLER creates the custom
      // domain and its DNS record during the deploy — there is no separate DNS step,
      // and this line is what performs it.
      //
      // 🔴 It is also why the prod API token needs two ZONE-scoped permissions the dev
      // token deliberately lacks — Workers Routes: Edit and Zone: Read on
      // danjamkuhn.com. Dev is a *.workers.dev hostname and was minted with Zone
      // Resources: none, correctly. Copying that recipe for prod fails here, after the
      // migrations in the step before have already run. See docs/deployment.md.
      "routes": [{ "pattern": "knag.danjamkuhn.com", "custom_domain": true }],

      // Both off. Each is an alternate hostname reaching the same Worker, and every
      // alternate hostname is one more surface the login rate-limit rule does not
      // cover.
      "workers_dev": false,
      "preview_urls": false,

      "observability": {
        "enabled": true
      }
    }
  }

  // Secrets (`wrangler secret put --env <env>`), never in this file — it is committed:
  //   KNAG_OPERATOR_EMAIL — the operator's address (ADR-008); claimed by the first login request
  //   RESEND_API_KEY      — the login mail (ADR-008 §9). One key can serve both environments.
  //   KNAG_BEARER_TOKEN   — agent / MCP / any non-browser client. Different per environment.
}
